# Variables de entorno de IA InkaShop
# Copia este archivo como ".env.local" y completa los valores para desarrollo.
# El archivo .env.local está ignorado por git (la clave nunca se sube al repositorio).

# Interruptor del modo del asistente (frontend):
#   false = modo simulado (chatbot académico, sin conexión, sin costo)
#   true  = modo IA real (usa DeepSeek a través de /api/chat)
VITE_USAR_IA_REAL=false

# Clave de DeepSeek (proveedor del chatbot). SOLO se usa en el servidor (/api/chat).
# NUNCA debe empezar con VITE_ ni colocarse en el frontend.
DEEPSEEK_API_KEY=

# ----- Supabase (opcional): base de datos / autenticación real -----
# Si NO se configuran, la app sigue funcionando con localStorage (modo local).
#   false = autenticación local (sin conexión)
#   true  = autenticación real con Supabase
VITE_USAR_SUPABASE=false
# Datos del proyecto Supabase (Project Settings -> API). Son PÚBLICOS; los protege RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
