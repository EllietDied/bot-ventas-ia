# Variables de entorno de IA InkaShop (Versión Beta RA3)
# Copia este archivo como ".env.local" y completa lo que necesites.
# .env.local está ignorado por git: las claves NUNCA se suben al repositorio.

# ===== Asistente IA =====
# false = IA simulada (clase ChatBotIA, reglas locales, sin internet ni clave) [fallback obligatorio]
# true  = IA real con DeepSeek a través de /api/chat
VITE_USAR_IA_REAL=false
# Clave de DeepSeek. SOLO se usa en el servidor (api/chat.ts). NUNCA con prefijo VITE_,
# nunca en el frontend ni en localStorage.
DEEPSEEK_API_KEY=
# (Opcional) Modelo de DeepSeek a usar. Si no se define, se usa "deepseek-v4-pro".
# Para volver al modelo anterior al instante (sin redesplegar): DEEPSEEK_MODELO=deepseek-chat
DEEPSEEK_MODELO=

# ===== Persistencia =====
# false = modo local con localStorage (funciona sin claves) [fallback académico]
# true  = persistencia real con Supabase
VITE_USAR_SUPABASE=false
# Datos del proyecto Supabase (Project Settings -> API). La anon/publishable es
# PÚBLICA (la protegen las políticas RLS); va en el frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ===== API REST (carpeta api/, Vercel Serverless Functions) =====
# La API del lado del servidor usa estas variables (sin prefijo VITE_).
# Si no las defines, la API reutiliza VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY.
# La anon key valida sesiones y conserva RLS. La service role es SECRETA y se usa
# únicamente en operaciones privilegiadas del servidor, como acreditar recargas.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ===== Pagos (Culqi) =====
# false = pago simulado (no se cobra nada) [por defecto]. true = pasarela Culqi.
VITE_USAR_PAGOS_REALES=false
# Llave PÚBLICA de Culqi (pk_test_... en sandbox, pk_live_... en producción). Va en el frontend.
VITE_CULQI_PUBLIC_KEY=
# Llave SECRETA de Culqi (sk_test_... / sk_live_...). SOLO servidor, NUNCA con VITE_ ni en el frontend.
CULQI_SECRET_KEY=
# Secreto del WEBHOOK de pagos: invéntate un texto largo y aleatorio. Debe ir en la URL
# del webhook configurada en Culqi (…/api/pago-webhook?token=ESTE_VALOR). Sin él, un
# atacante podría enviar pagos falsos. SOLO servidor.
CULQI_WEBHOOK_SECRET=
